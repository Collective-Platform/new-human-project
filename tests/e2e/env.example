# Copy to .env.test.local. Use only a separate local test database.
DATABASE_PROVIDER=local
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/rhythm_test
SESSION_SECRET=replace-with-a-test-only-secret
# The progress page loads Bible text from YouVersion on the server.
YVP_APP_KEY=replace-with-your-youversion-key
YVP_BIBLE_ID_EN=111
YVP_BIBLE_ID_ZH=43
